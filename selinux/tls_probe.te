policy_module(tls_probe, 1.0.0)

require {
    type bin_t;
    type sysfs_t;
    type debugfs_t;
    type proc_t;
    type user_home_t;
    type var_log_t;
    class capability { net_admin sys_resource };
    class capability2 { bpf perfmon };
    class bpf { map_create map_read map_write prog_load prog_run };
    class file { create read write open getattr execute execute_no_trans map };
    class dir { search read write add_name };
    class netlink_route_socket { create bind getattr read write nlmsg_read nlmsg_write };
    class perf_event { open read write };
}

type tls_probe_t;
type tls_probe_exec_t;
init_daemon_domain(tls_probe_t, tls_probe_exec_t)

type tls_probe_log_t;
logging_log_file(tls_probe_log_t)

allow tls_probe_t self:capability { net_admin sys_resource };
allow tls_probe_t self:capability2 { bpf perfmon };

allow tls_probe_t self:bpf { map_create map_read map_write prog_load prog_run };

allow tls_probe_t self:netlink_route_socket { create bind getattr read write nlmsg_read nlmsg_write };

allow tls_probe_t sysfs_t:dir { search read };
allow tls_probe_t sysfs_t:file { read open getattr };

allow tls_probe_t debugfs_t:dir { search read };
allow tls_probe_t debugfs_t:file { read open getattr };

allow tls_probe_t proc_t:dir { search read };
allow tls_probe_t proc_t:file { read open getattr };

allow tls_probe_t self:perf_event { open read write };

allow tls_probe_t tls_probe_log_t:dir { search read write add_name };
allow tls_probe_t tls_probe_log_t:file { create read write open getattr };

allow tls_probe_t var_log_t:dir { search read write add_name };
allow tls_probe_t var_log_t:file { create read write open getattr };
